<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <None Include="dashboard\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Also embedded: spec §4 wants a copy inside the exe as a fallback, so deleting the
         folder beside it degrades the report's provenance rather than breaking it. -->
    <EmbeddedResource Include="dashboard\**\*" LogicalName="dashboard/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
